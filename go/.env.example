# Salin file ini menjadi .env lalu isi dengan nilai asli.
#     cp .env.example .env
#
# .env tidak boleh di-commit. Jalankan `go run ./cmd/api` dari folder go/
# dan file ini akan dibaca otomatis saat startup.

# JWT_SECRET — WAJIB, minimal 32 karakter.
# Dipakai menandatangani token JWT (HS256, simetris). Secret yang lemah atau
# mudah ditebak berarti siapa pun bisa membuat token palsu dengan role admin.
# Generate dengan: head -c 48 /dev/urandom | base64 | tr -d '=+/'
JWT_SECRET=

# DATABASE_URL — WAJIB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/central_db?sslmode=disable

# PORT — opsional, default 8090.
PORT=8090

# CORS_ORIGIN — opsional, default http://localhost:3000.
# Origin frontend yang diizinkan mengakses API (header Access-Control-Allow-Origin).
# Set ke domain produksi frontend saat deploy.
CORS_ORIGIN=http://localhost:3000

# TRUSTED_PROXIES — opsional, daftar IP/CIDR reverse proxy yang boleh mengisi
# X-Forwarded-For, dipisah koma. Contoh: 127.0.0.1/32,10.0.0.5
# Jika kosong, header X-Forwarded-For/X-Real-IP diabaikan dan rate limit
# memakai alamat koneksi langsung. Saat Next.js berada di depan API, isi
# dengan alamat host Next.js agar IP klien bisa diteruskan dengan aman.
TRUSTED_PROXIES=

# ERROR_ALERT_WEBHOOK_URL — opsional. URL webhook Slack/Discord/generik untuk
# notifikasi error baru. Kosongkan untuk mematikan alert (error tetap disimpan
# ke tabel t_error_groups/t_error_events).
# Contoh Slack: https://hooks.slack.com/services/XXX/YYY/ZZZ
ERROR_ALERT_WEBHOOK_URL=

# ERROR_ALERT_COOLDOWN — opsional, default 24h. Error dengan fingerprint sama
# hanya memicu alert lagi setelah jeda ini. Format durasi Go: 30m, 6h, 24h.
ERROR_ALERT_COOLDOWN=24h

# ERROR_INGEST_KEY — opsional tetapi disarankan di produksi. Kunci bersama
# antara route handler Next.js dan backend untuk POST /api/errors. Isi nilai
# acak yang sama di next/.env.local. Bila kosong, endpoint menerima laporan
# tanpa kunci (khusus pengembangan lokal).
# Generate: head -c 32 /dev/urandom | base64 | tr -d '=+/'
ERROR_INGEST_KEY=
