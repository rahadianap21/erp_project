# Salin file ini menjadi .env lalu isi dengan nilai asli.
#     cp .env.example .env
#
# .env tidak boleh di-commit. Jalankan `go run ./cmd/api` dari folder go/
# dan file ini akan dibaca otomatis saat startup.

# JWT_SECRET — WAJIB, minimal 32 karakter.
# Dipakai menandatangani token JWT (HS256, simetris). Secret yang lemah atau
# mudah ditebak berarti siapa pun bisa membuat token palsu dengan role admin.
# Generate dengan: head -c 48 /dev/urandom | base64 | tr -d '=+/'
JWT_SECRET=

# DATABASE_URL — WAJIB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/central_db?sslmode=disable

# PORT — opsional, default 8090.
PORT=8090

# CORS_ORIGIN — opsional, default http://localhost:3000.
# Origin frontend yang diizinkan mengakses API (header Access-Control-Allow-Origin).
# Set ke domain produksi frontend saat deploy.
CORS_ORIGIN=http://localhost:3000